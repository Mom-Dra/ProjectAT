    <ui:VisualElement name="HUD_LeftBottom" style="flex-grow: 1; position: absolute; left: 20px; bottom: 20px; height: 30%; width: 13%;">
        <ui:VisualElement name="Panel" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.59); border-top-left-radius: 25px; border-top-right-radius: 25px; border-bottom-right-radius: 25px; border-bottom-left-radius: 25px; flex-direction: column;">
            <ui:VisualElement name="PlayerInfo" style="flex-grow: 1; flex-direction: row; align-self: auto; align-items: auto; justify-content: flex-start; width: 200px; height: 200px; align-content: flex-start; position: absolute; transform-origin: center; bottom: auto; left: 20px; top: 10px;">
                <ui:VisualElement name="Portrait" style="flex-grow: 1; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Images/Portraits/Grenadier_Portrait.jpg?fileID=21300000&amp;guid=fa3b6bd2205a7384590518eab9304662&amp;type=3#Grenadier_Portrait&quot;); background-color: rgb(255, 255, 255); flex-shrink: 1; flex-direction: column; align-items: stretch; align-content: auto; border-top-left-radius: 200px; border-top-right-radius: 200px; border-bottom-right-radius: 200px; border-bottom-left-radius: 200px; margin-top: auto; margin-right: auto; margin-bottom: auto; margin-left: auto; border-top-width: 0; border-bottom-width: 0; border-right-width: 0; border-left-width: 0; transform-origin: center; flex-basis: 1px; position: absolute;" />
                <RadialProgressBar line-width="15" progress-color="#A0FF6AFF" progress="30" name="HealthBar" track-color="#3F3F3FFF" style="width: 101%; height: 101%; position: absolute; top: -1px; left: -1px; flex-grow: 1;" />
