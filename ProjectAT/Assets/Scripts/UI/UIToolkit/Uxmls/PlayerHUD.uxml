                <ui:VisualElement name="Portrait" style="flex-grow: 1; width: 100%; height: 100%; background-image: url(&quot;project://database/Assets/Images/SkillIcons/BandageSkillIcon.jpg?fileID=21300000&amp;guid=eb79b5bc03af50b4cbf8fde7e1d70566&amp;type=3#BandageSkillIcon&quot;); background-color: rgb(255, 255, 255); flex-shrink: 1; flex-direction: column; align-items: stretch; align-content: auto; border-top-left-radius: 200px; border-top-right-radius: 200px; border-bottom-right-radius: 200px; border-bottom-left-radius: 200px; margin-top: auto; margin-right: auto; margin-bottom: auto; margin-left: auto; border-top-width: 0; border-bottom-width: 0; border-right-width: 0; border-left-width: 0; transform-origin: center; flex-basis: 1px; position: absolute;" />
