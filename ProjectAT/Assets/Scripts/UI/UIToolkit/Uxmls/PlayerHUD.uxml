<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="HUD_LeftBottom" style="flex-grow: 1; position: absolute; left: 1%; bottom: 1%; height: 30%; width: 24%; flex-direction: row;">
