            <ui:Label text="W" name="KeyText" style="position: relative; bottom: 15%; font-size: 30px; background-color: rgb(255, 255, 255); border-top-right-radius: 5px; border-top-left-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; color: rgb(215, 66, 66); width: 40px; -unity-text-align: upper-center; height: 40px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px;" />
        </ui:VisualElement>
        <ui:VisualElement name="SkillInfo_2" style="flex-grow: 1; align-items: center;">
            <ui:VisualElement name="Icon" style="flex-grow: 0; position: relative; flex-shrink: 0; justify-content: space-around; align-items: center; width: 120px; height: 120px; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=5866165431930342980&amp;guid=f64a09cc786454e4b8c3699700b5b5e9&amp;type=3#Remove@2x&quot;); background-color: rgb(0, 0, 0); background-repeat: no-repeat no-repeat; opacity: 1; display: flex; visibility: visible; overflow: visible;">
                <CooldownOverlay name="SkillCoolDown" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0;" />
            </ui:VisualElement>
            <ui:Label text="0" name="ItemCount" style="position: absolute; bottom: auto; font-size: 30px; background-color: rgb(101, 101, 101); border-top-right-radius: 5px; border-top-left-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; color: rgb(255, 255, 255); width: 40px; -unity-text-align: upper-center; height: 40px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; top: 0; right: 25%; opacity: 1;" />
            <ui:Label text="E" name="KeyText" style="position: relative; bottom: 15%; font-size: 30px; background-color: rgb(255, 255, 255); border-top-right-radius: 5px; border-top-left-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; color: rgb(215, 66, 66); width: 40px; -unity-text-align: upper-center; height: 40px; margin-top: 2px; padding-left: 2px; margin-left: 2px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; margin-right: 2px; margin-bottom: 2px;" />
        </ui:VisualElement>
        <ui:VisualElement name="SkillInfo_3" style="flex-grow: 1; align-items: center;">
            <ui:VisualElement name="Icon" style="flex-grow: 0; position: relative; flex-shrink: 0; justify-content: space-around; align-items: center; width: 120px; height: 120px; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=5866165431930342980&amp;guid=f64a09cc786454e4b8c3699700b5b5e9&amp;type=3#Remove@2x&quot;); background-color: rgb(0, 0, 0);">
                <CooldownOverlay name="SkillCoolDown" fill-amount="0" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0;" />
            </ui:VisualElement>
            <ui:Label text="0" name="ItemCount" style="position: absolute; bottom: auto; font-size: 30px; background-color: rgb(101, 101, 101); border-top-right-radius: 5px; border-top-left-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; color: rgb(255, 255, 255); width: 40px; -unity-text-align: upper-center; height: 40px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; top: 0; right: 25%;" />
            <ui:Label text="D" name="KeyText" style="position: relative; bottom: 15%; font-size: 30px; background-color: rgb(255, 255, 255); border-top-right-radius: 5px; border-top-left-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; color: rgb(215, 66, 66); width: 40px; -unity-text-align: upper-center; height: 40px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;" />
        </ui:VisualElement>
        <ui:VisualElement name="SkillInfo_4" enabled="true" style="flex-grow: 1; align-items: center;">
            <ui:VisualElement name="Icon" style="flex-grow: 0; position: relative; flex-shrink: 0; justify-content: space-around; align-items: center; width: 120px; height: 120px; background-image: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=5866165431930342980&amp;guid=f64a09cc786454e4b8c3699700b5b5e9&amp;type=3#Remove@2x&quot;); background-color: rgb(0, 0, 0);">
                <CooldownOverlay name="SkillCoolDown" fill-amount="0" style="position: absolute; top: 0; right: 0; bottom: 0; left: 0;" />
            </ui:VisualElement>
            <ui:Label text="0" name="ItemCount" enabled="true" style="position: absolute; bottom: auto; font-size: 30px; background-color: rgb(101, 101, 101); border-top-right-radius: 5px; border-top-left-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; color: rgb(255, 255, 255); width: 40px; -unity-text-align: upper-center; height: 40px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; top: 0; right: 25%;" />
            <ui:Label text="A" name="KeyText" style="position: relative; bottom: 15%; font-size: 30px; background-color: rgb(255, 255, 255); border-top-right-radius: 5px; border-top-left-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; color: rgb(215, 66, 66); width: 40px; -unity-text-align: upper-center; height: 40px; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <TabbedView />
    <ui:VisualElement name="MissionTracker" class="mission-tracker mission-tracker--visible" picking-mode="Ignore">
        <ui:VisualElement name="MissionPanel" class="mission-panel" picking-mode="Ignore">
            <ui:VisualElement name="MissionContent" class="mission-content" picking-mode="Ignore">
                <ui:Label text="Mission" class="mission-kicker" picking-mode="Ignore" />
                <ui:Label name="MissionDescription" text="Mission Description" class="mission-description" picking-mode="Ignore" />
                <ui:VisualElement name="MissionObjectives" class="mission-objectives" picking-mode="Ignore">
                    <ui:VisualElement class="mission-objective" picking-mode="Ignore">
                        <ui:Label text="✓" class="mission-objective__marker" picking-mode="Ignore" />
                        <ui:Label text="Eliminate enemy forces" class="mission-objective__text" picking-mode="Ignore" />
                        <ui:Label text="0 / 6" class="mission-objective__progress" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="mission-objective" picking-mode="Ignore">
                        <ui:Label text="✓" class="mission-objective__marker" picking-mode="Ignore" />
                        <ui:Label text="Interact with the computer" class="mission-objective__text" picking-mode="Ignore" />
                        <ui:Label text="0 / 1" class="mission-objective__progress" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="MissionSweep" class="mission-sweep" picking-mode="Ignore" style="display: none;" />
            <ui:VisualElement name="MissionCompleteOverlay" class="mission-complete-overlay" picking-mode="Ignore" style="display: none;">
                <ui:Label text="MISSION COMPLETE" class="mission-complete-text" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="MissionAllClear" class="mission-all-clear" picking-mode="Ignore" style="display: none;">
                <ui:VisualElement name="AllClearIcon" class="mission-all-clear-icon" picking-mode="Ignore" />
                <ui:Label name="AllClearFallbackIcon" text="✓" class="mission-all-clear-fallback" picking-mode="Ignore" style="display: none;" />
                <ui:Label text="Mission All Clear" class="mission-all-clear-text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
