.pause-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
}

.pause-view {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.pause-navigation {
    position: absolute;
    left: 8%;
    top: 12%;
    width: 340px;
    flex-direction: column;
    align-items: flex-start;
}

.pause-title-container {
    width: 260px;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 24px;
}

.pause-title {
    color: rgb(255, 255, 255);
    font-size: 56px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 2px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.pause-title-underline {
    width: 205px;
    height: 4px;
    background-color: rgb(255, 255, 255);
}

.pause-button-list {
    width: 330px;
    flex-direction: column;
    align-items: flex-start;
}

.pause-button {
    width: 320px;
    height: 58px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 10px;
    padding-left: 12px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    color: rgba(255, 255, 255, 0.88);
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    transition-property: color, translate;
    transition-duration: 0.08s;
}

.pause-button:hover {
    color: rgb(255, 255, 255);
    translate: 6px 0;
    border-left-width: 3px;
    border-left-color: rgb(255, 255, 255);
}

.pause-button:active {
    color: rgba(255, 255, 255, 0.65);
    translate: 3px 0;
}

.pause-button:disabled {
    color: rgba(255, 255, 255, 0.35);
}

.option-view {
    position: absolute;
    left: 5.7%;
    right: 4%;
    top: 5.8%;
    bottom: 5.8%;
    display: none;
    flex-direction: column;
    padding-left: 60px;
    padding-right: 40px;
    padding-top: 30px;
    padding-bottom: 55px;
    background-color: rgb(71, 71, 71);
    border-top-left-radius: 32px;
    border-top-right-radius: 32px;
    border-bottom-left-radius: 32px;
    border-bottom-right-radius: 32px;
}

.option-header {
    height: 105px;
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
}

.option-title {
    color: rgb(255, 255, 255);
    font-size: 70px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.option-action-buttons {
    flex-direction: row;
    align-items: flex-start;
    padding-top: 2px;
}

.option-action-button {
    width: 100px;
    height: 50px;
    margin-left: 16px;
    color: rgb(255, 255, 255);
    background-color: rgb(87, 76, 76);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 27px;
    -unity-font-style: bold;
}

.option-action-button:hover {
    background-color: rgb(112, 96, 96);
}

.option-action-button:active {
    background-color: rgb(69, 60, 60);
}

.option-body {
    flex-grow: 1;
    flex-direction: row;
}

.option-tabs {
    width: 250px;
    flex-shrink: 0;
    flex-direction: column;
    padding-top: 18px;
    background-color: rgb(54, 54, 54);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

.option-tab {
    height: 125px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-left: 18px;
    padding-right: 8px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.option-tab:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.option-tab--selected {
    background-color: rgba(255, 255, 255, 0.08);
}

.option-tab-indicator {
    width: 24px;
    flex-shrink: 0;
    color: rgb(255, 255, 255);
    font-size: 44px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.option-tab-label {
    color: rgb(255, 255, 255);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.option-scroll-view {
    flex-grow: 1;
    margin-left: 30px;
    background-color: rgb(71, 71, 71);
}

.option-scroll-view .unity-scroll-view__content-container {
    flex-grow: 1;
}

.option-scroll-view .unity-scroller--vertical {
    width: 22px;
    margin-left: 12px;
    background-color: rgba(0, 0, 0, 0);
}

.option-scroll-view .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgb(224, 224, 224);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.option-scroll-view .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(224, 224, 224);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.option-scroll-view .unity-scroller__low-button,
.option-scroll-view .unity-scroller__high-button {
    display: none;
}

.option-content {
    flex-grow: 1;
    width: 100%;
}

.graphic-content {
    min-height: 500px;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
}

.not-implemented-label {
    color: rgb(255, 255, 255);
    font-size: 46px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.sound-content,
.control-content {
    flex-direction: column;
}

.graphic-setting-name {
    width: auto;
    flex-basis: 0;
    flex-grow: 3;
    flex-shrink: 1;
}

.graphic-dropdown {
    height: 55px;
    flex-basis: 0;
    flex-grow: 7;
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.graphic-dropdown .unity-base-field__label {
    display: none;
}

.graphic-dropdown .unity-base-field__input,
.graphic-dropdown .unity-base-popup-field__input {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 0;
    margin-right: 0;
}

.graphic-dropdown .unity-base-popup-field__input {
    height: 55px;
    padding-left: 16px;
    padding-right: 12px;
    color: rgb(0, 0, 0);
    background-color: rgb(224, 224, 224);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.graphic-dropdown .unity-base-popup-field__text {
    color: rgb(0, 0, 0);
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.graphic-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.graphic-dropdown:hover .unity-base-popup-field__input {
    background-color: rgb(242, 242, 242);
}

.graphic-dropdown:focus .unity-base-popup-field__input {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(82, 163, 0);
    border-right-color: rgb(82, 163, 0);
    border-top-color: rgb(82, 163, 0);
    border-bottom-color: rgb(82, 163, 0);
}

.graphic-toggle-control {
    position: relative;
    height: 55px;
    flex-basis: 0;
    flex-grow: 7;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.graphic-toggle {
    position: absolute;
    left: 42%;
    top: 0;
    translate: -50% 0;
    width: 65px;
    height: 55px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    opacity: 0;
}

.graphic-toggle-checkmark {
    position: absolute;
    left: 42%;
    top: 0;
    translate: -50% 0;
    width: 65px;
    height: 55px;
    color: rgb(0, 0, 0);
    background-color: rgb(224, 224, 224);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.graphic-toggle-control:hover .graphic-toggle-checkmark {
    background-color: rgb(242, 242, 242);
}

.option-setting-row {
    min-height: 120px;
    flex-direction: row;
    align-items: center;
    margin-bottom: 20px;
    padding-left: 28px;
    padding-right: 38px;
    background-color: rgb(54, 54, 54);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.option-setting-name {
    width: 165px;
    flex-shrink: 0;
    color: rgb(255, 255, 255);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.sound-volume-control {
    position: relative;
    height: 55px;
    flex-grow: 1;
}

.sound-slider-track {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
    background-color: rgb(224, 224, 224);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.sound-slider-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgb(82, 163, 0);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
    border-bottom-left-radius: 9px;
    border-bottom-right-radius: 9px;
}

.sound-slider-value {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(0, 0, 0);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.sound-slider {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.sound-slider .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.sound-slider .unity-base-slider__dragger {
    width: 1px;
    height: 1px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.control-setting-row {
    min-height: 120px;
}

.control-key-button {
    height: 55px;
    flex-grow: 1;
    color: rgb(0, 0, 0);
    background-color: rgb(224, 224, 224);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.control-key-button:hover {
    background-color: rgb(242, 242, 242);
}

.control-key-button:focus {
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: rgb(82, 163, 0);
    border-right-color: rgb(82, 163, 0);
    border-top-color: rgb(82, 163, 0);
    border-bottom-color: rgb(82, 163, 0);
}
